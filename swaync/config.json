{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"positionX": "right",
	"positionY": "top",
	"layer": "overlay",
	"control-center-layer": "top",
	"layer-shell": true,
	"cssPriority": "user",
	"reload_style_on_change": true,
	"control-center-margin-top": 65,
	"control-center-margin-bottom": 0,
	"control-center-margin-right": 35,
	"control-center-margin-left": 0,
	"notification-2fa-action": false,
	"notification-inline-replies": true,
	"notification-icon-size": 50,
	"notification-body-image-height": 160,
	"notification-body-image-width": 200,
	"notification-window-width": 400,
	"timeout": 4,
	"timeout-low": 3,
	"timeout-critical": 0,
	"fit-to-screen": false,
	"control-center-width":30,
	"control-center-height": 900,
	"keyboard-shortcuts": false,
	"image-visibility": "always",
	"transition-time": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"script-fail-notify": true,
	"widgets": [
		"dnd",
		"mpris",
		"buttons-grid",
		"volume",
		"backlight",
		"title",
		"notifications"
	],
	"widget-config": {
		"title": {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": ""
		},
		"dnd": {
			"text": "Do Not Disturb"
		},
		"label": {
			"max-lines": 1,
			"text": "Notification"
		},
		"mpris": {
			"image-size":50,
			"image-radius": 12,
			"alignment": "center"
		},
		"volume": {
			"label": "",
			"show-per-app": true,
			"show-per-app-icon": true
		},
		"backlight": {
			"label": "󰃠 ",
			"device": "amdgpu_bl2"
		},
		"buttons-grid": {
			"actions": [
				{
					"label": "󰤨 ",
					"command": "kitty -e --title=speedtest --hold speedtest"
				},
				{
					"label": "󰂯",
					"command": "blueman-manager"
				},
				{
					"label": "󰻃",
					"command": "obs"
				}
			]
			
		}
	}
}
