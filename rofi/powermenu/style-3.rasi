/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
    kb-row-up: "l,k";
    kb-row-down: "h,j";
    kb-accept-entry: "space,Return";
}
@import                          "/home/denko/.config/rofi/catppuccin-mocha.rasi"

/*****----- Global Properties -----*****/
* {
    font:                        "fira code Nerd Font mono 11";
    background:                  @base;
    background-alt:              @base;
    normal-background:           @base;
    foreground:                  @text;
    selected:                    @text;
    active:                      @text;
    urgent:                      #f7c297ff;
    alternate-normal-background: #0091ffff; 
    altalt:                     @text;
    bordercol:                   #5c7cf0ff; 
    selectedlol:                 #ff5e004d;
    border-radius:               100px;
}

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    east;
    anchor:                      east;
    fullscreen:                  false;
    width:                       100;
    height:                      510;
    x-offset:                    -30px;
    y-offset:                     0px;
    border:                      1px solid;
    border-color:                #ffffff7f;

    /* properties for all widgets */
    enabled:                     true;
    border-radius:               100%;
    cursor:                      "default";
    background-color:            @background;
}
/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
background-image: linear-gradient(to bottom, 
    #7f849c80, 
    #7f849c36, 
    #ffffff14,
    #ffffff14, 
    #ffffff14, 
    #ffffff14, 
    #ffffff14, 
    #ffffff14, 
    #ffffff14, 
    #ffffff14, 
    #ffffff14, 
    #7f849c27, 
    #7f849c66  
  );
    orientation:                 vertical;

    children:                    ["listview" ];
}
/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    padding:                     10px 10 10 10px;
    background-color:            @altalt;
    background-image:            url("/home/denko/Pictures/Wallpapers/17424f17748898566.jpg", width);
    text-color:                  @foreground;
    orientation:                 vertical;
    children:                    [ "textbox-prompt-colon", "prompt"];
    border-radius:               100%;
}
dummy {
    background-color:            transparent;
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "     ";
    padding:                     10px 0px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  inherit;
    font:                        "feather bold 13";
}
prompt {
    enabled:                     true;
    padding:                     12 200px;
    border-radius:               100%;
    background-color:            @active;
    text-color:                  @background;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     12px;
    border:                      0px solid;
    border-radius:               100%;
    border-color:                @selected;
    background-color:            @background-alt;
    text-color:                  @foreground;
}
textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0;
    horizontal-align:            0;
    placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     12px;
    border:                      0px solid;
    border-radius:               100px;
    border-color:                @selected;
    background-color:            @background;
    text-color:                  @foreground;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     20px;
    margin:                      8px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               100px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     20px 0px;
    border:                      0px solid;
    border-radius:               100%;
    border-color:               #ffffff1c; 
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    font:                        "fira code Nerd Font mono 25";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0;
    horizontal-align:            0.5;
}
element selected.normal {
    background-color:            @active;
    text-color:                  #000000;
}
#element.normal.normal {
   background-color: #00000000;
   text-color: @inverse-surface; 
   border-radius:               100%;
}

#element.alternate.normal {
   background-color: #00000000;
   text-color: @inverse-surface; 
}
